 "widgets": {
  "widget_1": {
   "uri": "widgets/common/text/",
   "label": "Title",
   "config": {
    "text": "<p><strong style=\"font-size: 18px; color: #ffffff;\">{{event.name}} - Request Data Collection</strong></p>",
    "style": {
     "verticalAlign": "center",
     "wrap": true,
     "padding": "p-2"
    }
   },
   "useDataSources": [],
   "id": "widget_1",
   "version": "1.18.0"
  },
