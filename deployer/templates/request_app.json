    }
   ],
   "enableDataAction": false,
   "id": "widget_5",
   "version": "1.18.0"
  },
  "widget_6": {
   "uri": "widgets/common/search/",
   "label": "Find a place",
   "config": {
    "searchResultView": "Result_Panel",
    "arrangementStyle": "Style1",
    "maxSuggestions": 6,
    "recentSearchesMaxNumber": 6,
    "resultMaxNumber": 6,
    "datasourceConfig": [],
    "enableFiltering": true,
