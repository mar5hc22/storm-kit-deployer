      "color": "transparent"
     }
    }
   },
   "id": "widget_2",
   "version": "1.18.0"
  },
  "widget_3": {
   "uri": "widgets/common/text/",
   "label": "Text",
   "config": {
    "text": "<p><strong style=\"font-size: 18px;\">Ask for drone footage, drone imagery, or a home or infrastructure assessment</strong></p><p>1. Choose Data collection requests below and draw the area on the map.</p><p>2. Pick what you need, name the area, say how urgent it is and who to contact.</p><p>3. Press Create. The response team sees it on the Tracker page.</p>",
    "style": {
     "verticalAlign": "start",
     "wrap": true
    }
   },
   "useDataSources": [],
   "id": "widget_3",
   "version": "1.18.0"
  },
  "widget_4": {
   "uri": "widgets/common/edit/",
   "label": "Request form",
   "config": {
    "layersConfig": [],
    "editMode": "GEOMETRY",
    "mapViewsConfig": {},
    "description": "",
    "noDataMessage": "",
    "snapSettingMode": "PRESCRIPTIVE",
    "selfSnapping": true,
    "featureSnapping": true,
    "defaultSelfEnabled": true,
    "defaultFeatureEnabled": true
   },
   "useMapWidgetIds": [
    "widget_5"
   ],
   "id": "widget_4",
   "version": "1.18.0"
  },
  "widget_5": {
   "uri": "widgets/arcgis/arcgis-map/",
   "label": "Request map",
   "config": {
    "toolConfig": {
     "canZoom": true,
     "canHome": true,
     "canSearch": false,
     "canNavigation": false
    },
    "isUseCustomMapState": false,
    "initialMapState": null,
    "initialMapDataSourceID": "dataSource_1"
   },
   "layouts": {
