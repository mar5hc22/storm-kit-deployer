   {
    "id": "topo",
    "layerType": "VectorTileLayer",
    "title": "World Topographic Map",
    "styleUrl": "https://cdn.arcgis.com/sharing/rest/content/items/7dc6cea0b1764a1f9af2e679f642f0f5/resources/styles/root.json"
   }
  ]
 },
 "initialState": {
  "viewpoint": {
   "targetGeometry": {
    "xmin": -180,
    "ymin": 15,
    "xmax": -60,
    "ymax": 72,
    "spatialReference": {
     "wkid": 4326
    }
   }
  }
 },
