   },
   "popupInfo": {
    "title": "{request_type}: {area_name}",
    "fieldInfos": [
     {
      "fieldName": "request_type",
      "label": "Request",
      "visible": true
     },
     {
      "fieldName": "area_name",
      "label": "Area",
      "visible": true
     },
     {
      "fieldName": "details",
      "label": "Details",
      "visible": true
     },
     {
      "fieldName": "priority",
      "label": "Priority",
      "visible": true
     },
     {
      "fieldName": "needed_by",
      "label": "Needed by",
      "visible": true
     },
     {
      "fieldName": "status",
      "label": "Status",
      "visible": true
     },
     {
      "fieldName": "requester_name",
      "label": "Requested by",
      "visible": true
     },
     {
      "fieldName": "requester_org",
      "label": "Organization",
      "visible": true
     },
     {
      "fieldName": "requester_contact",
      "label": "Contact",
      "visible": true
     },
     {
      "fieldName": "assigned_to",
      "label": "Assigned to",
      "visible": true
     },
     {
      "fieldName": "response_notes",
      "label": "Response notes",
      "visible": true
     }
    ]
   },
   "formInfo": {
    "title": "Data collection request",
    "description": "Draw the area on the map, then say what you need there.",
    "formElements": [
     {
      "type": "group",
      "label": "Request",
      "initialState": "expanded",
      "formElements": [
       {
        "type": "field",
        "fieldName": "request_type",
        "label": "What do you need?",
        "inputType": {
         "type": "combo-box",
         "showNoValueOption": false
        }
       },
       {
        "type": "field",
        "fieldName": "area_name",
        "label": "Name of the area",
        "inputType": {
         "type": "text-box",
         "minLength": 0,
         "maxLength": 120
        }
       },
       {
        "type": "field",
        "fieldName": "details",
        "label": "Details",
        "description": "What to capture, access notes, hazards.",
        "inputType": {
         "type": "text-area",
         "minLength": 0,
         "maxLength": 2000
        }
       },
       {
        "type": "field",
        "fieldName": "priority",
        "label": "Priority",
        "inputType": {
         "type": "combo-box",
         "showNoValueOption": false
        }
       },
       {
        "type": "field",
        "fieldName": "needed_by",
        "label": "Needed by",
        "inputType": {
         "type": "datetime-picker",
         "includeTime": false
        }
       },
       {
        "type": "field",
        "fieldName": "requester_name",
        "label": "Your name",
        "inputType": {
         "type": "text-box",
         "minLength": 0,
         "maxLength": 120
        }
       },
       {
        "type": "field",
        "fieldName": "requester_org",
        "label": "Your organization",
        "inputType": {
         "type": "text-box",
         "minLength": 0,
         "maxLength": 120
        }
       },
       {
        "type": "field",
        "fieldName": "requester_contact",
        "label": "Phone or email",
        "inputType": {
         "type": "text-box",
         "minLength": 0,
         "maxLength": 200
        }
       }
      ]
     },
     {
      "type": "group",
      "label": "Response team",
      "initialState": "collapsed",
      "formElements": [
       {
        "type": "field",
        "fieldName": "status",
        "label": "Status",
        "inputType": {
         "type": "combo-box",
         "showNoValueOption": false
        }
       },
       {
        "type": "field",
        "fieldName": "assigned_to",
        "label": "Assigned to",
        "inputType": {
         "type": "text-box",
         "minLength": 0,
         "maxLength": 120
        }
       },
       {
        "type": "field",
        "fieldName": "response_notes",
        "label": "Response notes",
        "inputType": {
         "type": "text-area",
         "minLength": 0,
         "maxLength": 2000
        }
       }
      ]
     }
    ]
   }
  }
 ],
 "tables": [],
